# Copy this file to .env and adjust. Every value is optional for local use.

PORT=3000
# Public URL used in email links
PUBLIC_URL=http://localhost:3000

# Set a long random string. If empty, a random one is generated on each start
# (everyone gets signed out whenever the server restarts).
JWT_SECRET=

# Admin account created on first start
ADMIN_EMAIL=admin@chitkara.edu
ADMIN_PASSWORD=admin123
ADMIN_NAME=Campus Admin

# Insert a few demo reports when the database is empty (true/false)
SEED_DEMO_DATA=true

# Set true only when serving over HTTPS
COOKIE_SECURE=false

# SQLite file location (default: ./data/lostlink.db)
DB_PATH=

# Matching thresholds (0-100)
MATCH_MIN_SCORE=50
MATCH_STRONG_SCORE=70

# Email (Nodemailer). If SMTP_HOST is empty, emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LostLink <no-reply@lostlink.local>
